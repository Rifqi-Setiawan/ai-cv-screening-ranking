[Unit]
Description=CV Screening & Ranking Platform - FastAPI REST Backend (Port 8110)
After=network.target postgresql-kms.service
Wants=postgresql-kms.service

[Service]
Type=simple
WorkingDirectory=/srv/hermes-control/services/cv-screening
Environment=PATH=/srv/hermes-control/services/cv-screening/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/srv/hermes-control/services/cv-screening/.env
ExecStart=/srv/hermes-control/services/cv-screening/.venv/bin/uvicorn src.api.main:app --host 127.0.0.1 --port 8110 --workers 2 --proxy-headers --forwarded-allow-ips="127.0.0.1" --access-log
Restart=always
RestartSec=5s

# Resource & Security Constraints
MemoryMax=1.5G
TasksMax=100
LimitNOFILE=65536
PrivateTmp=true

[Install]
WantedBy=default.target
