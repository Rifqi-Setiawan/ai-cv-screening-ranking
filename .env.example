# Environment Configuration Template for CV Screening Platform
APP_ENV=development
APP_PORT=8110
APP_HOST=127.0.0.1

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/cv_screening
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_OUTPUT_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
METRICS_TOKEN=GANTI_DENGAN_OUTPUT_openssl_rand_hex_32
PII_ENCRYPTION_KEY=GANTI_DENGAN_OUTPUT_openssl_rand_hex_32

# Storage
STORAGE_VAULT_PATH=/srv/hermes-control/services/cv-screening/data/cv-vault
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://screening.rifqisetiawan.my.id"]

# LLM Gateway & Privacy Policy
# 'redacted_dev_router' enables 9Router for development with automated PII pre-flight verification
# 'paid_or_local_only' restricts calls strictly to official metered APIs or local offline models
LLM_DATA_POLICY=redacted_dev_router
LLM_GATEWAY_URL=http://127.0.0.1:20128/v1
LLM_GATEWAY_KEY=
LLM_MODEL_JD_COMPILER=ag/gemini-3.8-flash-high
LLM_MODEL_VERIFIER=ag/gemini-3.8-flash-high
LLM_TEMPERATURE=0.0
VERIFIER_CONCURRENCY=5

# Administrative Eligibility Gate
ELIGIBILITY_FOUR_EYES=true

# Taxonomy & Domain Configuration
TAXONOMY_DIR=config/taxonomy

# Hybrid Retrieval & Scoring Mode (FX-32)
SCORING_MODE=rules
SEMANTIC_THRESHOLD=0.65

# Embedding Model Configuration
EMBEDDING_MODEL=microsoft/harrier-oss-v1-270m
EMBEDDING_DIM=640
