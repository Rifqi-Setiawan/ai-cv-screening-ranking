# Environment Configuration Template for CV Screening Platform
APP_ENV=development
APP_PORT=8110
APP_HOST=127.0.0.1

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://cv_screening_user:59Vf0GijbEHFxZyfUHsjoJs9@127.0.0.1:5432/cv_screening
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage
STORAGE_VAULT_PATH=/srv/hermes-control/services/cv-screening/data/cv-vault
MAX_UPLOAD_SIZE_MB=10

# LLM Gateway & Privacy Policy
# LLM_DATA_POLICY enforces data classification:
# 'paid_or_local_only' -> Blocks sending original CVs to free/unmetered models
LLM_DATA_POLICY=paid_or_local_only
LLM_GATEWAY_URL=http://127.0.0.1:20128/v1
LLM_GATEWAY_KEY=
LLM_MODEL_JD_COMPILER=ag/gemini-3.8-flash-high
LLM_TEMPERATURE=0.0

# Embedding Model Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
